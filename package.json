{
  "name": "@dmh2002/dsh-coldread-cache",
  "version": "0.1.0",
  "description": "DSH plugin: keep a session's parsed event log resident so a local append extends the resident parse instead of invalidating it — a long session is parsed once per host process, not once per read.",
  "type": "module",
  "license": "MIT",
  "author": "dingminhua",
  "contributors": [
    {
      "name": "iuuuuuuuu",
      "url": "https://github.com/iuuuuuuuu"
    }
  ],
  "copyright": "Copyright (c) 2026 LaoDing",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node tests/probe-deps.mjs && node tests/probe-install.mjs",
    "gate": "node --expose-gc --max-old-space-size=12288 tests/gate/run.mjs",
    "perf": "node --expose-gc --max-old-space-size=12288 tests/perf-ab.mjs",
    "fault": "node --expose-gc --max-old-space-size=8192 tests/fault-injection.mjs",
    "probe:freeze": "node --expose-gc --max-old-space-size=12288 tests/probe-extension-cost.mjs",
    "probe:evict": "node --expose-gc --max-old-space-size=12288 tests/probe-eviction.mjs",
    "probe:budget": "node --expose-gc --max-old-space-size=12288 tests/probe-budget.mjs",
    "probe:heap": "node --expose-gc --max-old-space-size=12288 tests/probe-heap.mjs",
    "probe:traffic": "node --expose-gc --max-old-space-size=12288 tests/probe-traffic-shape.mjs",
    "probe:handle": "node --expose-gc --max-old-space-size=8192 tests/probe-write-handle.mjs",
    "probe:defaults": "node tests/probe-defaults.mjs",
    "probe:status": "node --expose-gc --max-old-space-size=8192 tests/probe-status-fields.mjs",
    "probe:overbudget": "node --expose-gc --max-old-space-size=8192 tests/probe-overbudget.mjs",
    "probe:contract": "node --expose-gc --max-old-space-size=8192 tests/probe-compat-contract.mjs",
    "probe:headers": "node --expose-gc --max-old-space-size=12288 tests/probe-header-cache.mjs",
    "probe:torn": "node --expose-gc --max-old-space-size=12288 tests/probe-torn-tail.mjs",
    "probe:mutation": "node --expose-gc --max-old-space-size=12288 tests/probe-torn-mutation.mjs",
    "probe:keyorder": "node tests/probe-key-order.mjs",
    "probe:walk": "node --expose-gc --max-old-space-size=8192 tests/probe-walk-cost.mjs",
    "probe:history": "node --expose-gc --max-old-space-size=12288 tests/probe-history-path.mjs",
    "probe:liststages": "node --expose-gc --max-old-space-size=12288 tests/probe-list-stages.mjs",
    "probe:cold": "node --expose-gc --max-old-space-size=12288 tests/probe-cold-decoder-ab.mjs",
    "probe:resolve": "node --expose-gc --max-old-space-size=12288 tests/probe-decoder-resolve.mjs",
    "probe:segments": "node --expose-gc --max-old-space-size=12288 tests/probe-validator-segments.mjs",
    "probe:breakdown": "node --expose-gc --max-old-space-size=12288 tests/probe-breakdown.mjs",
    "probe:artifact": "node --expose-gc --max-old-space-size=12288 tests/probe-artifact-cost.mjs",
    "compat": "node --expose-gc --max-old-space-size=12288 tests/compat-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "session",
    "session-persistence",
    "performance",
    "zstd",
    "jsonl",
    "cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingminhua/dsh-coldread-cache.git"
  },
  "bugs": {
    "url": "https://github.com/dingminhua/dsh-coldread-cache/issues"
  },
  "homepage": "https://github.com/dingminhua/dsh-coldread-cache#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-format": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-format-catalog": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-format-v3-to-v4": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-catalog": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-v3-to-v4": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence-jsonl": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
