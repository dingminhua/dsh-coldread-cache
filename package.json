{
  "name": "dsh-coldread-cache",
  "version": "0.1.0",
  "description": "DSH plugin: keep a session's parsed event log resident so a local append extends the resident parse instead of invalidating it — a long session is parsed once per host process, not once per read.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node tests/probe-deps.mjs && node tests/probe-install.mjs",
    "gate": "node --expose-gc --max-old-space-size=12288 tests/gate/run.mjs",
    "perf": "node --expose-gc --max-old-space-size=12288 tests/perf-ab.mjs",
    "fault": "node --expose-gc --max-old-space-size=8192 tests/fault-injection.mjs",
    "probe:freeze": "node --expose-gc --max-old-space-size=12288 tests/probe-extension-cost.mjs",
    "probe:evict": "node --expose-gc --max-old-space-size=12288 tests/probe-eviction.mjs",
    "probe:budget": "node --expose-gc --max-old-space-size=12288 tests/probe-budget.mjs",
    "probe:heap": "node --expose-gc --max-old-space-size=12288 tests/probe-heap.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "session",
    "session-persistence",
    "performance",
    "zstd",
    "jsonl",
    "cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iuuuuuuuu/dsh-coldread-cache.git"
  },
  "bugs": {
    "url": "https://github.com/iuuuuuuuu/dsh-coldread-cache/issues"
  },
  "homepage": "https://github.com/iuuuuuuuu/dsh-coldread-cache#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-format": "*",
    "@deepseek-ai/dsh-session-format-catalog": "*",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "*",
    "@deepseek-ai/dsh-session-persistence": "*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-catalog": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-v3-to-v4": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence-jsonl": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
